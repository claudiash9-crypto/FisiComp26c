import numpy as np
import matplotlib.pyplot as plt

def sumar_nc(n):
    if n < 10000000 or n > 99999999:
        print("El número no tiene 8 dígitos")
        return
    if n > 31120001:
        print("Este número no es una fecha")
        return
        
    suma= 0
    producto =1

    while n>0:
        digito = n % 10
        if digito !=0:
            suma+= digito
            producto*= digito
        n= n//10
    print("suma=", suma, ";Producto=", producto)


sumar_nc(12032026)
sumar_nc(311986)
sumar_nc(40022028)






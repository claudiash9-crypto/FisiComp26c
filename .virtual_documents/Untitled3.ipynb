import numpy as np
import matplotlib.pyplot as plt


def deriv_sim(f,x):
    df = np.zeros_like(f)
    for i in range(1,len(x)-1):
        df[i] = (f[i+1]-f[i-1])/(x[i+1]-x[i-1])
    df[0] = (f[1]-f[0])/(x[1]-x[0])
    df[-1] = -(f[-2]-f[-1])/(x[-1]-x[-2])
    return df


h = 0.01
x = np.arrange(1e-3, 1+h, h)
y= 1/x**4 -1/x**2
plt.plot(x,y)
plt.ylim([-5,5])
plt.show()




import numpy as np
import matplotlib.pyplot as plt

x=np.linspace(-0.99,1,100)

def f1(x):
    f1= x**2 - x**4/2 + x**6/3 - x**8/4 + x**10/5
    return f1
def f2(x):
    f2= np.log(1+x**2)
    return f2

y1=f1(x)
y2=f2(x)

plt.plot(x,y1,label='función 1')
plt.plot(x,y2,label='función 2')
plt.title('funciones')
plt.xlabel(r'x'), plt.ylabel(r'y')
plt.grid(), plt.show()






import numpy as np
import matplotlib.pyplot as plt

x=np.linspace(-0.99,1,100)
# en lugar de -1 se pone -0.99
#porque log(-1)=0

def f1(x):
    f1= x - (x**2/2) +(x**3/3)
    return f1

def f2(x):
    f2= np.log(1+x)
    return f2
    
f1=f1(x)
f2=f2(x)

plt.plot(x,f1, label='función 1')
plt.plot(x,f2, label='función 2')
plt.title('funciones')
plt.xlabel(r'x'), plt.ylabel(r'y')
plt.grid(), plt.legend(), plt.show()






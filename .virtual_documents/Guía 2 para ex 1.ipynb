import numpy as np
import matplotlib.pyplot as plt

def sumar_nc(n):
    if n < 100000000 or n > 999999999:
        print("El número no tiene 9 dígitos")
        return
    suma= 0
    producto =1

    while n>0:
        digito = n % 10
        if digito !=0:
            suma+= digito
            producto*= digito
        n= n//10
    print("suma=", suma, ";Producto=", producto)


sumar_nc(456982671)
sumar_nc(623548)


sumar_nc(46287368710)



